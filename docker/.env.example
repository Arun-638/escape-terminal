# Escape The Terminal - Production & Development Environment Configuration
# All software used is 100% Free and Open Source (₹0 Cost)

# CTFd Secret Key for sessions and CSRF protection
SECRET_KEY=generate_a_random_32_byte_hex_string_for_production

# PostgreSQL Database Configuration
POSTGRES_DB=ctfd
POSTGRES_USER=ctfd
POSTGRES_PASSWORD=ctfd_secure_password_replace_in_prod

# Game and Competition Settings
GAME_DURATION=50
HINT_PENALTY_POINTS=25
HINT_PENALTY_MINUTES=2
MAX_TEAMS=40
TEAM_SIZE_MIN=2
TEAM_SIZE_MAX=3
ENABLE_BONUS=false
LEADERBOARD_ENABLED=true

# Container Resource Limits for Player Sandboxes
CONTAINER_MEMORY=256m
CONTAINER_CPU=0.5
CONTAINER_PIDS=100
